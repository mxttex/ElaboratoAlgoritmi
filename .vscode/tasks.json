{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build C89 Program",
            "command": "C:\\Program Files\\CodeBlocks\\mingw64\\bin\\gcc.exe", // <--- Deve essere identico!
            "args": [
                "-fdiagnostics-color=always",
                "-std=c89",          // Forces the C89 standard
                "-pedantic",         // Issues warnings for non-standard C
                "-Wall",             // Enables all standard warnings
                "-Wextra",           // Enables extra warnings for good practice
                "-g",                // Generates debugging information
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: MinGW gcc.exe"
        }
    ]
}