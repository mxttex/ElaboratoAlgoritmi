{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build C89${file} Program",
            "command": "gcc",
            "args": [
                "-std=c89",
                "-Wall",
                "-Wpedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compilazione ANSI C89 - Algoritmi UniBO"
        }
    ]
}